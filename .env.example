SECRET_KEY=cambia_esto_por_una_clave_segura
DATABASE_URL=mysql+pymysql://guardias:password@db/guardias

MAIL_SERVER=smtp.tuinstituto.es
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=guardias@tuinstituto.es
MAIL_PASSWORD=tu_password
MAIL_DEFAULT_SENDER=guardias@tuinstituto.es

# Nombre del instituto (aparece en la cabecera)
INSTITUTE_NAME=IES Ciudad Jardín

# Email del usuario administrador del sistema: protegido (no se puede borrar ni
# renombrar desde el panel) y se crea/recrea automáticamente si no existe.
# Si se omite esta variable, se usa admin@ies.es por defecto.
ADMIN_EMAIL=admin@ies.es
